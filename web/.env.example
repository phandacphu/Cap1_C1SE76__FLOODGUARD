# Copy this file to ".env" (do NOT commit ".env").
# Base URL of the FLOODGUARD backend REST API, no trailing slash.
# Shared demo API (default if this variable is missing):
VITE_API_URL=https://floodguard-backend-demo.onrender.com/api
# Local backend instead:
# VITE_API_URL=http://localhost:5000/api
