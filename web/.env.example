# Base URL includes /api; no trailing slash. Public map data uses this same API client configuration.
VITE_API_URL=https://floodguard-backend-demo.onrender.com/api

# Admin Flood Warning V2 TEST ONLY. Only active under `vite dev`; never in production builds.
# Set true locally for synthetic alerts; defaults to false when omitted.
VITE_ADMIN_FLOOD_WARNING_MOCK=false

# MapTiler browser key restricted by allowed origins
VITE_MAPTILER_KEY=

# Rescue Warning V2 uses authenticated HTTP by default. Set VITE_API_URL to Phu's confirmed V2 server.
# Example local Backend (only when actually running): http://127.0.0.1:5003/api
# Explicit DEV-only fixture preview; no automatic fallback on API errors.
VITE_RESCUE_FLOOD_WARNING_MOCK=false
