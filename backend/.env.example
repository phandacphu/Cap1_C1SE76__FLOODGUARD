PORT=5000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Base64-encoded Firebase service account JSON.
# Required in demo/deployed environments.
# Local development can continue using serviceAccountKey.json.
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_here

# Server-side openrouteservice API key (never commit a real key).
ORS_API_KEY=

# V2 event preparation/cancellation only; no FCM sends in PHASE4. Disabled by default.
FLOOD_WARNING_V2_EVENT_WORKER_ENABLED=false

# V2 FCM sender: separate opt-in. Test mode requires explicit TEST account IDs.
FLOOD_WARNING_V2_PUSH_ENABLED=false
FLOOD_WARNING_V2_PUSH_MODE=test
FLOOD_WARNING_V2_TEST_RECIPIENT_IDS=
