    {
      "name": "Thien — Device/GPS (Resident only)",
      "item": [
        {
          "name": "Read installation for reconciliation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{residentToken}}"
              },
              {
                "key": "X-Installation-Secret",
                "value": "{{installationSecret}}"
              }
            ],
            "url": "{{baseUrl}}/notification-devices/{{installationId}}",
            "description": "Manual TEST only; use the role token of the active current account. Do not run the whole collection as a Runner."
          }
        },
        {
          "name": "Register/update current installation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{residentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Installation-Secret",
                "value": "{{installationSecret}}"
              }
            ],
            "url": "{{baseUrl}}/notification-devices/{{installationId}}",
            "description": "Manual TEST only; use the role token of the active current account. Do not run the whole collection as a Runner.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"android\",\n  \"fcmToken\": null,\n  \"notificationPermission\": \"denied\",\n  \"registrationId\": \"{{registrationId}}\",\n  \"expectedBindingId\": null,\n  \"expectedRevision\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('allowWrites') !== 'YES_TEST_ONLY') { throw new Error('Read-only default. Enable writes only on the TEST environment approved by Phu.'); }",
                  "if (!String(pm.environment.get('title') || '').startsWith('TEST ONLY')) { throw new Error('Use a TEST ONLY title.'); }",
                  "if (!pm.environment.get('requestId')) { pm.environment.set('requestId', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===200){const d=pm.response.json().data.device;pm.environment.set('bindingId',d.bindingId);pm.environment.set('deviceRevision',d.revision);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read current location evaluation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{residentToken}}"
              },
              {
                "key": "X-Installation-Secret",
                "value": "{{installationSecret}}"
              },
              {
                "key": "X-Installation-Id",
                "value": "{{installationId}}"
              },
              {
                "key": "X-Device-Binding-Id",
                "value": "{{bindingId}}"
              }
            ],
            "url": "{{baseUrl}}/flood-alerts/location-evaluation",
            "description": "Manual TEST only; use the role token of the active current account. Do not run the whole collection as a Runner."
          }
        },
        {
          "name": "Upload location unavailable (increase sequence yourself)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{residentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Installation-Secret",
                "value": "{{installationSecret}}"
              },
              {
                "key": "X-Installation-Id",
                "value": "{{installationId}}"
              },
              {
                "key": "X-Device-Binding-Id",
                "value": "{{bindingId}}"
              }
            ],
            "url": "{{baseUrl}}/flood-alerts/location",
            "description": "Manual TEST only; use the role token of the active current account. Do not run the whole collection as a Runner.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sequence\": {{sequence}},\n  \"availability\": \"unavailable\",\n  \"reason\": \"no_fix\",\n  \"location\": null,\n  \"capturedAt\": null,\n  \"accuracyM\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('allowWrites') !== 'YES_TEST_ONLY') { throw new Error('Read-only default. Enable writes only on the TEST environment approved by Phu.'); }",
                  "if (!String(pm.environment.get('title') || '').startsWith('TEST ONLY')) { throw new Error('Use a TEST ONLY title.'); }",
                  "if (!pm.environment.get('requestId')) { pm.environment.set('requestId', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload a fresh TEST GPS sample (keep body when retrying)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{residentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Installation-Secret",
                "value": "{{installationSecret}}"
              },
              {
                "key": "X-Installation-Id",
                "value": "{{installationId}}"
              },
              {
                "key": "X-Device-Binding-Id",
                "value": "{{bindingId}}"
              }
            ],
            "url": "{{baseUrl}}/flood-alerts/location",
            "description": "Manual TEST only; use the role token of the active current account. Do not run the whole collection as a Runner.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sequence\": {{sequence}},\n  \"availability\": \"available\",\n  \"reason\": null,\n  \"location\": {\n    \"latitude\": {{latitude}},\n    \"longitude\": {{longitude}}\n  },\n  \"capturedAt\": \"{{capturedAt}}\",\n  \"accuracyM\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('allowWrites') !== 'YES_TEST_ONLY') { throw new Error('Read-only default. Enable writes only on the TEST environment approved by Phu.'); }",
                  "if (!String(pm.environment.get('title') || '').startsWith('TEST ONLY')) { throw new Error('Use a TEST ONLY title.'); }",
                  "if (!pm.environment.get('requestId')) { pm.environment.set('requestId', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Unbind exact current account before logout",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{residentToken}}"
              },
              {
                "key": "X-Installation-Secret",
                "value": "{{installationSecret}}"
              },
              {
                "key": "X-Installation-Id",
                "value": "{{installationId}}"
              },
              {
                "key": "X-Device-Binding-Id",
                "value": "{{bindingId}}"
              }
            ],
            "url": "{{baseUrl}}/notification-devices/{{installationId}}",
            "description": "Manual TEST only; use the role token of the active current account. Do not run the whole collection as a Runner."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('allowWrites') !== 'YES_TEST_ONLY') { throw new Error('Read-only default. Enable writes only on the TEST environment approved by Phu.'); }",
                  "if (!String(pm.environment.get('title') || '').startsWith('TEST ONLY')) { throw new Error('Use a TEST ONLY title.'); }",
                  "if (!pm.environment.get('requestId')) { pm.environment.set('requestId', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            }
          ]
        }
